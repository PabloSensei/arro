# The release smoke run: every button of the stripes, every pair of the right stripe,
# the terminal and the preview of a markdown file. Run it from the repository root with
#   arro --state-dir target/smoke-state --script-file tools/smoke/release.script .
# The lines of the checks and the summary land in target/smoke-report.txt as well as
# in the terminal.
report:target/smoke-report.txt

# The window may show a notification of its own (a failed language server, for
# one) and may save its tool windows open or closed. Every block below starts from a
# window with no tool window and no balloon: `hide-tools` closes what the saved state
# left open, and every notification block starts from a closed balloon.
hide-tools

# The right stripe: each button shows its own window.
click:stripe-s-bookmarks
expect:places-popup
expect:places-empty
close-notification
click:stripe-s-notifications
expect:notification
expect-not:places-popup
click:stripe-s-ai
expect-tool:ai
click:stripe-s-tasks
expect-tool:tasks

# Back to a window with nothing open on the right. The AI sessions and the tasks share
# their dock, so closing the tasks closes the dock for both.
click:stripe-s-tasks
expect-no-tool:tasks
expect-no-tool:ai
close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-notifications
expect-not:notification

# Pairs of the right stripe: the button pressed second shows its own window. Every
# block closes what it opened, so the next block starts from the same window.

close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-ai
expect-tool:ai
click:stripe-s-ai
expect-no-tool:ai
click:stripe-s-notifications
expect-not:notification

close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-tasks
expect-tool:tasks
click:stripe-s-tasks
expect-no-tool:tasks
click:stripe-s-notifications
expect-not:notification

close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-bookmarks
expect:places-empty
click:stripe-s-bookmarks
expect-not:places-popup
click:stripe-s-notifications
expect-not:notification

click:stripe-s-ai
expect-tool:ai
close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-notifications
expect-not:notification
click:stripe-s-ai
expect-no-tool:ai

click:stripe-s-ai
expect-tool:ai
click:stripe-s-tasks
expect-tool:tasks
click:stripe-s-tasks
expect-no-tool:tasks
expect-no-tool:ai

click:stripe-s-ai
expect-tool:ai
click:stripe-s-bookmarks
expect:places-empty
click:stripe-s-bookmarks
expect-not:places-popup
click:stripe-s-ai
expect-no-tool:ai

click:stripe-s-tasks
expect-tool:tasks
close-notification
click:stripe-s-notifications
expect:notification
click:stripe-s-notifications
expect-not:notification
click:stripe-s-tasks
expect-no-tool:tasks

click:stripe-s-tasks
expect-tool:tasks
click:stripe-s-ai
expect-tool:ai
click:stripe-s-ai
expect-no-tool:ai
expect-no-tool:tasks

click:stripe-s-tasks
expect-tool:tasks
click:stripe-s-bookmarks
expect:places-empty
click:stripe-s-bookmarks
expect-not:places-popup
click:stripe-s-tasks
expect-no-tool:tasks

click:stripe-s-bookmarks
expect:places-empty
close-notification
click:stripe-s-notifications
expect:notification
expect-not:places-popup
click:stripe-s-notifications
expect-not:notification

click:stripe-s-bookmarks
expect:places-empty
click:stripe-s-ai
expect-tool:ai
expect-not:places-popup
click:stripe-s-ai
expect-no-tool:ai

click:stripe-s-bookmarks
expect:places-empty
click:stripe-s-tasks
expect-tool:tasks
expect-not:places-popup
click:stripe-s-tasks
expect-no-tool:tasks

# The left stripe: each button shows its own tool window. `hide-tools` above closed
# every tool window, so the first press of each button opens its window.
click:stripe-s-project
expect-tool:project
click:stripe-s-project
expect-no-tool:project

click:stripe-s-commit
expect-tool:commit
click:stripe-s-commit
expect-no-tool:commit

click:stripe-s-log
expect-tool:log
click:stripe-s-log
expect-no-tool:log

click:stripe-s-structure
expect-tool:structure
click:stripe-s-structure
expect-no-tool:structure

click:stripe-s-run
expect-tool:run
click:stripe-s-run
expect-no-tool:run

click:stripe-s-debug
expect-tool:debug
click:stripe-s-debug
expect-no-tool:debug

click:stripe-s-terminal
expect-tool:terminal
click:stripe-s-terminal
expect-no-tool:terminal

click:stripe-s-services
expect-tool:services
click:stripe-s-services
expect-no-tool:services

click:stripe-s-todo
expect-tool:todo
click:stripe-s-todo
expect-no-tool:todo

click:stripe-s-problems
expect-tool:problems
click:stripe-s-problems
expect-no-tool:problems

click:stripe-s-usages
expect-tool:usages
click:stripe-s-usages
expect-no-tool:usages

# A live terminal: the window closes while ping still runs, and the process has to go
# with it.
show:terminal
expect-tool:terminal
type:ping -t 127.0.0.1\n
wait:2000

# The preview of a markdown file: the text and the rendered document stand beside each
# other, and the three buttons of the modes switch them. The file is the readme of the
# project the run opens, and the terminal above stays live until the window goes.
open:README.md
expect:markdown-editor-text
expect:markdown-preview-text
click:markdown-mode-editor
expect-not:markdown-preview-text
click:markdown-mode-preview
expect-not:markdown-editor-text
click:markdown-mode-split
expect:markdown-editor-text
expect:markdown-preview-text
close-window
