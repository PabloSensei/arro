[Desktop Entry]
Type=Application
Name=Arro
GenericName=Java IDE
Comment=A native Java IDE
Exec="@ARRO_DIR@/arro" %F
TryExec="@ARRO_DIR@/arro"
Icon=arro
Terminal=false
Categories=Development;IDE;
